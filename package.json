{
  "name": "@ryanfowler/legible",
  "version": "0.1.0",
  "description": "Fast readable-content extraction for Node.js, powered by the Legible Rust crate",
  "main": "index.js",
  "types": "index.d.ts",
  "repository": {
    "url": "git+https://github.com/ryanfowler/legible-node.git",
    "type": "git"
  },
  "license": "Apache-2.0",
  "keywords": [
    "napi-rs",
    "NAPI",
    "N-API",
    "Rust",
    "node-addon",
    "node-addon-api"
  ],
  "files": [
    "index.d.ts",
    "index.js",
    "*.node",
    "README.md",
    "LICENSE"
  ],
  "napi": {
    "binaryName": "legible",
    "packageName": "@ryanfowler/legible",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "x86_64-pc-windows-msvc"
    ],
    "constEnum": false,
    "runtimeStringEnum": false,
    "dtsHeaderFile": "types-header.d.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "artifacts": "napi artifacts --output-dir artifacts --npm-dir npm",
    "verify:artifacts": "node scripts/verify-artifacts.mjs --artifacts-dir artifacts",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:registry": "node scripts/verify-registry.mjs",
    "bench": "node --import @oxc-node/core/register benchmark/bench.ts",
    "bench:memory": "node --expose-gc --import @oxc-node/core/register benchmark/memory.ts",
    "bench:rust": "cargo run --release --bin direct-rust-bench -- benchmark/fixtures",
    "build": "napi build --platform --release",
    "postbuild": "node scripts/fix-dts.mjs",
    "build:debug": "napi build --platform",
    "postbuild:debug": "node scripts/fix-dts.mjs",
    "format": "run-p format:oxfmt format:rs",
    "format:oxfmt": "oxfmt",
    "format:rs": "cargo fmt",
    "lint": "oxlint",
    "prepublishOnly": "napi prepublish -t npm --no-gh-release && node scripts/verify-registry.mjs --platforms-only",
    "test": "run-s test:types test:unit",
    "test:dts": "node scripts/verify-dts.mjs",
    "test:types": "run-s test:dts test:types:ts",
    "test:types:ts": "tsc --noEmit -p __test__/options-tsconfig.json",
    "test:unit": "ava",
    "version": "napi version"
  },
  "devDependencies": {
    "@emnapi/core": "^2.0.0-alpha.4",
    "@emnapi/runtime": "^2.0.0-alpha.4",
    "@napi-rs/cli": "^3.8.6",
    "@napi-rs/wasm-runtime": "^1.2.3",
    "@oxc-node/core": "^0.1.0",
    "ava": "^8.0.1",
    "chalk": "^6.0.0",
    "emnapi": "^2.0.0-alpha.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "prettier": "^3.9.6",
    "tinybench": "^6.1.3",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.@(js|ts|tsx)": [
      "oxlint --fix"
    ],
    "*.@(js|ts|tsx|yml|yaml|md|json|toml)": [
      "oxfmt --write"
    ]
  },
  "ava": {
    "extensions": [
      "ts"
    ],
    "timeout": "2m",
    "workerThreads": false,
    "environmentVariables": {
      "TS_NODE_PROJECT": "./tsconfig.json"
    },
    "nodeArguments": [
      "--import",
      "@oxc-node/core/register"
    ]
  },
  "packageManager": "pnpm@11.22.0"
}
